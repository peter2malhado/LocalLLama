<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="localllama.PersonalitiesPage"
             BackgroundColor="#121221"
             Title="Personalidades">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,30"
                             Spacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Personalidades"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Escolhe uma personalidade pronta ou cria a tua antes de entrar no chat."
                       FontSize="14"
                       TextColor="#B7B7C9" />
            </VerticalStackLayout>

            <Frame Padding="14"
                   BackgroundColor="#1B1B31"
                   BorderColor="#323256"
                   CornerRadius="18"
                   HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Selecionada agora"
                           FontSize="12"
                           TextColor="#A7A7C7" />
                    <Label Text="{Binding CurrentSelectionName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <CollectionView ItemsSource="{Binding Personalities}"
                            SelectionMode="Single"
                            SelectionChanged="OnPersonalitySelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="16"
                               Margin="0,0,0,12"
                               BackgroundColor="#1A1A2E"
                               BorderColor="#31314D"
                               CornerRadius="18"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="#B8B8C8" />
                                <HorizontalStackLayout Spacing="10"
                                                       IsVisible="{Binding IsCustom}">
                                    <Button Text="Editar"
                                            Clicked="OnEditCustomClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FFA726"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="14,8" />
                                    <Button Text="Apagar"
                                            Clicked="OnDeleteCustomClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E53935"
                                            TextColor="White"
                                            CornerRadius="14"
                                            Padding="14,8" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Frame Padding="18"
                   BackgroundColor="#18182B"
                   BorderColor="#2F2F4A"
                   CornerRadius="18"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding EditorTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Entry Placeholder="Nome da personalidade"
                           Text="{Binding CustomName}"
                           TextColor="White"
                           PlaceholderColor="#8F90AA"
                           BackgroundColor="#24243A" />

                    <Editor Placeholder="Escreve aqui o prompt da personalidade..."
                            Text="{Binding CustomPrompt}"
                            TextColor="White"
                            PlaceholderColor="#8F90AA"
                            BackgroundColor="#24243A"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="180" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="{Binding SaveButtonText}"
                                Clicked="OnSaveCustomClicked"
                                BackgroundColor="#FF7043"
                                TextColor="White"
                                CornerRadius="16"
                                Padding="14,12"
                                HorizontalOptions="FillAndExpand" />

                        <Button Text="Cancelar"
                                Clicked="OnCancelEditClicked"
                                BackgroundColor="#4B5563"
                                TextColor="White"
                                CornerRadius="16"
                                Padding="14,12"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsEditingCustom}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Entrar no chat com esta personalidade"
                    Clicked="OnContinueToChatClicked"
                    BackgroundColor="#10A37F"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    Padding="16,14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

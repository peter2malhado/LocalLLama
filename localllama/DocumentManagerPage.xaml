<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:localllama.ViewModels"
             x:Class="localllama.DocumentManagerPage"
             Title="Documentos">

    <ContentPage.BindingContext>
        <vm:DocumentManagerViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource AppBg1}" Offset="0.0" />
            <GradientStop Color="{StaticResource AppBg2}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource AppSurface}"
               BorderColor="{StaticResource AppBorder}"
               CornerRadius="16"
               Padding="16"
               HasShadow="False">
            <VerticalStackLayout Spacing="6">
                <Label Text="Documentos Locais"
                       FontSize="22"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold" />
                <Label Text="Importa e gere documentos usados pelo RAG local"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Frame>

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="10"
                               Padding="0,12,0,12">
            <Button Text="📎 Adicionar documento"
                    BackgroundColor="{StaticResource AppAccent}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    CornerRadius="12"
                    Command="{Binding ImportCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Documents}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource AppSurface}"
                           BorderColor="{StaticResource AppBorder}"
                           CornerRadius="16"
                           Padding="14"
                           Margin="0,8">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="6"
                              ColumnSpacing="8">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="18"
                                   FontFamily="OpenSansSemibold" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding SizeText}"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="12" />

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{Binding DateText, StringFormat='Importado em {0}'}"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="12" />

                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Text="{Binding ChunkCount, StringFormat='Chunks: {0}'}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="12" />

                            <Button Grid.Row="0"
                                    Grid.RowSpan="4"
                                    Grid.Column="1"
                                    Text="Apagar"
                                    BackgroundColor="{StaticResource AppDanger}"
                                    TextColor="White"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="12"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentManagerViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="30">
                    <Label Text="📄"
                           FontSize="56"
                           HorizontalOptions="Center" />
                    <Label Text="Ainda não tens documentos locais"
                           FontSize="18"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="localllama.chatpage"
             BackgroundColor="#1E1E1E"
             Padding="10">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="4,0,4,10">
            <Label Text="Conversa"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Frame Grid.Column="1"
                   Padding="12,6"
                   BackgroundColor="#2B2B40"
                   BorderColor="#45456B"
                   CornerRadius="16"
                   HasShadow="False"
                   HorizontalOptions="End">
                <Label Text="{Binding PersonalityName}"
                       TextColor="#E7D9FF"
                       FontSize="13"
                       FontAttributes="Bold" />
            </Frame>
        </Grid>

        <!-- Lista de mensagens -->
        <CollectionView x:Name="MessagesView"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="Transparent"
                        Margin="0,0,0,10">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">
                        <Frame CornerRadius="15"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="{Binding IsUser, Converter={StaticResource MessageColorConverter}}"
                               HorizontalOptions="{Binding IsUser, Converter={StaticResource MessageAlignmentConverter}}"
                               MaximumWidthRequest="280">
                            <Label Text="{Binding Text}"
                                   TextColor="White"
                                   FontSize="16"
                                   LineBreakMode="WordWrap" />
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Área de input -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              Padding="10"
              BackgroundColor="#2C2C2C">

            <Button Text="📎"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#3A3A52"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding ImportDocumentCommand}"
                    VerticalOptions="Center" />

            <Entry x:Name="MessageEntry"
                   Grid.Column="1"
                   Placeholder="Escreve a tua mensagem..."
                   Text="{Binding CurrentMessage, Mode=TwoWay}"
                   FontSize="16"
                   TextColor="White"
                   PlaceholderColor="#888"
                   BackgroundColor="Transparent"
                   VerticalOptions="Center"
                   Margin="10,0"
                   Completed="MessageEntry_Completed" />

            <Button Grid.Column="2"
                    Text="➤"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#10A37F"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding SendMessageCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <Frame Grid.Row="3"
               Margin="0,8,0,0"
               Padding="10"
               CornerRadius="14"
               HasShadow="False"
               BorderColor="#2A2A3D"
               BackgroundColor="#232338"
               IsVisible="{Binding IsDeveloperStatsVisible}">
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
                <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="0"
                                     Spacing="2">
                    <Label Text="Tempo de resposta"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding ResponseTimeText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="1"
                                     Spacing="2">
                    <Label Text="Tokens estimados"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding TokenStatsText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="0"
                                     Spacing="2">
                    <Label Text="Contexto"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding ContextStatsText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="1"
                                     Spacing="2">
                    <Label Text="Uso de RAM"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding MemoryUsageText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>

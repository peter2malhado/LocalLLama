<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="localllama.chatpage"
             BackgroundColor="#1E1E1E"
             Padding="10">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="4,0,4,10">
            <Label Text="Conversa"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />

            <Frame Grid.Column="1"
                   Padding="12,6"
                   BackgroundColor="#2B2B40"
                   BorderColor="#45456B"
                   CornerRadius="16"
                   HasShadow="False"
                   HorizontalOptions="End">
                <Label Text="{Binding PersonalityName}"
                       TextColor="#E7D9FF"
                       FontSize="13"
                       FontAttributes="Bold" />
            </Frame>
        </Grid>

        <!-- Lista de mensagens -->
        <CollectionView x:Name="MessagesView"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="Transparent"
                        Margin="0,0,0,10">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">
                        <Frame CornerRadius="15"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="{Binding IsUser, Converter={StaticResource MessageColorConverter}}"
                               HorizontalOptions="{Binding IsUser, Converter={StaticResource MessageAlignmentConverter}}"
                               MaximumWidthRequest="280">
                            <VerticalStackLayout Spacing="8">
                                <Image Source="{Binding ImagePath}"
                                       IsVisible="{Binding HasImage}"
                                       Aspect="AspectFill"
                                       HeightRequest="180" />
                                <Label Text="{Binding Text}"
                                       TextColor="White"
                                       FontSize="16"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Área de input -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto,Auto"
              Padding="10"
              BackgroundColor="#2C2C2C">

            <Button Text="📎"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#3A3A52"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding ImportDocumentCommand}"
                    VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="🖼️"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#3A3A52"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding PickImageCommand}"
                    VerticalOptions="Center" />

            <Entry x:Name="MessageEntry"
                   Grid.Column="2"
                   Placeholder="Escreve a tua mensagem..."
                   Text="{Binding CurrentMessage, Mode=TwoWay}"
                   FontSize="16"
                   TextColor="White"
                   PlaceholderColor="#888"
                   BackgroundColor="Transparent"
                   VerticalOptions="Center"
                   Margin="10,0"
                   Completed="MessageEntry_Completed" />

            <Button Grid.Column="3"
                    Text="➤"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="#10A37F"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding SendMessageCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="2"
              IsVisible="{Binding HasSelectedImage}"
              VerticalOptions="Start"
              Margin="70,-92,70,0"
              InputTransparent="False">
            <Frame Padding="6"
                   CornerRadius="14"
                   BackgroundColor="#141824"
                   BorderColor="#3A3A52"
                   HasShadow="False">
                <Grid ColumnDefinitions="*,Auto">
                    <Image Source="{Binding SelectedImagePath}"
                           Aspect="AspectFill"
                           HeightRequest="110" />
                    <Button Grid.Column="1"
                            Text="✕"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            BackgroundColor="#8A2F3B"
                            TextColor="White"
                            Command="{Binding ClearImageCommand}" />
                </Grid>
            </Frame>
        </Grid>

        <Frame Grid.Row="3"
               Margin="0,8,0,0"
               Padding="10"
               CornerRadius="14"
               HasShadow="False"
               BorderColor="#2A2A3D"
               BackgroundColor="#232338"
               IsVisible="{Binding IsDeveloperStatsVisible}">
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
                <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="0"
                                     Spacing="2">
                    <Label Text="Tempo de resposta"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding ResponseTimeText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="1"
                                     Spacing="2">
                    <Label Text="Tokens estimados"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding TokenStatsText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="0"
                                     Spacing="2">
                    <Label Text="Contexto"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding ContextStatsText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="1"
                                     Spacing="2">
                    <Label Text="Uso de RAM"
                           FontSize="12"
                           TextColor="#9AA0B4" />
                    <Label Text="{Binding MemoryUsageText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <Grid Grid.RowSpan="4"
              BackgroundColor="#B0000000"
              IsVisible="{Binding IsModelLoading}"
              InputTransparent="False">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="280"
                    Padding="24"
                    BackgroundColor="#171B2A"
                    Stroke="#2C3550"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="#7C4DFF"
                                       HeightRequest="42"
                                       WidthRequest="42" />
                    <Label Text="{Binding LoadingStatusText}"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Isto pode demorar alguns segundos."
                           TextColor="#A6AEC6"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
